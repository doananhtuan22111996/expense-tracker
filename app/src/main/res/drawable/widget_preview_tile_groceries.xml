<?xml version="1.0" encoding="utf-8"?>
<!--
    Rounded tile background for the "Groceries" preview tile. Hard-coded
    Material 3 light-scheme `tertiaryContainer` tone — same family as the
    live `CategoryTile`'s `colorKey="teal"` path, which resolves to
    `GlanceTheme.colors.tertiary` in the real widget.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <corners android:radius="12dp" />
    <solid android:color="#DCE7C8" />
</shape>
