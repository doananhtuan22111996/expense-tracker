<?xml version="1.0" encoding="utf-8"?>
<!--
    Rounded tile background for the "Food" preview tile on the medium widget
    picker preview. Hard-coded Material 3 light-scheme `errorContainer` tone —
    same family as the live `CategoryTile`'s `colorKey="red"` path, which
    resolves to `GlanceTheme.colors.error` in the real widget. Static hex here
    because the launcher picker runs outside the app's theme context.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <corners android:radius="12dp" />
    <solid android:color="#FFDAD6" />
</shape>
